@page "/orders"
@rendermode InteractiveServer

<PageTitle>Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Orders</h1>
    <a class="btn btn-primary" href="/orders/create">
        <i class="bi bi-plus-lg me-1"></i>New Order
    </a>
</div>

<ErrorAlert Message="@_errorMessage" @bind-Show="_showError" />

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" type="text" placeholder="Search by description..."
               @bind="_searchDescription" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="SearchAsync">
            <i class="bi bi-search me-1"></i>Search
        </button>
    </div>
</div>

@if (_loading)
{
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_orders.Count == 0)
{
    <p class="text-muted">No orders found.</p>
}
else
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Description</th>
                <th>Total</th>
                <th class="table-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in _orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Description</td>
                    <td>@order.Total.ToString("C")</td>
                    <td class="table-actions">
                        <a class="btn btn-sm btn-outline-primary" href="/orders/@order.Id" title="View">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" href="/orders/@order.Id/edit" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-danger" title="Delete"
                                @onclick="() => OpenDeleteDialog(order.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage">Previous</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @_currentPage of @_totalPages (@_totalRecords total)</span>
            </li>
            <li class="page-item @(_currentPage >= _totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage">Next</button>
            </li>
        </ul>
    </nav>
}

<DeleteConfirmDialog @ref="_dialog" OrderId="_deleteTargetId" OnConfirmed="ConfirmDeleteAsync" OnCancelled="() => {}" />
